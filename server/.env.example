PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=venus_db
JWT_SECRET=replace-with-a-long-random-secret
# Control de registro público (true para permitir, false para bloquear)
ALLOW_PUBLIC_REGISTRATION=false
# SMTP del proveedor de correo. Para Gmail usa smtp.gmail.com.
SMTP_HOST=smtp.example.com
# Gmail: 587 con SMTP_SECURE=false (STARTTLS) o 465 con SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
# Usa la cuenta SMTP y una contraseña de aplicación; nunca la contraseña normal.
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
# Remitente visible y autorizado por el proveedor SMTP.
MAIL_FROM=VENUS <no-reply@example.com>
# URL pública exacta de VenusWeb, sin barra final.
PUBLIC_WEB_URL=https://seo-sort-resource-might.trycloudflare.com
